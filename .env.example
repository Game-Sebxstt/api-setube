PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Lista separada por comas, coincidencia exacta. También define frame-ancestors de /file y /archive.
CORS_ORIGINS=http://localhost:3000
# false, número de saltos (p. ej. 1 detrás de Cloudflare/Caddy) o lista de CIDR.
TRUST_PROXY=false

# La contraseña va en la URL y debe ser hex (openssl rand -hex 32): redis://:<hex>@redis:6379/0
REDIS_URL=redis://redis:6379/0
# Secreto obligatorio en producción. Nunca se guardan IPs crudas.
IP_HASH_SALT=

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Arrays JSON que se anteponen al argv. Solo para tests; en prod vacíos.
YTDLP_ARGS_PREFIX=[]
FFMPEG_ARGS_PREFIX=[]

# Cookies: en producción usa YTDLP_COOKIES_FILE (p. ej. un Docker secret en /run/secrets/yt_cookies).
YTDLP_COOKIES_FILE=
# Solo desarrollo.
YOUTUBE_COOKIES_JSON=

AUDIO_HLS_FALLBACK=true
YTDLP_INFO_JSON=true

MAX_ITEMS_PER_JOB=50
MAX_PLAYLIST_ITEMS=50
MAX_RESOLVE_URLS=50
MAX_DURATION_AUDIO_SEC=3600
MAX_DURATION_VIDEO_SEC=1200

CONVERT_CONCURRENCY=4
QUEUE_MAX=200
QUEUE_WAIT_TIMEOUT_MS=300000
CONVERSION_TIMEOUT_MS=900000
CONVERSION_WALL_TIMEOUT_MS=3600000
STALL_TIMEOUT_MS=60000
SLOT_LEASE_MS=30000
WAIT_LEASE_MS=20000

MAX_STREAMS_PER_IP=3
MAX_STREAMS_PER_INSTANCE=40
ZIP_PARALLEL_AUDIO=3
ZIP_PARALLEL_VIDEO=1
ZIP_ITEM_BUFFER_BYTES=33554432

META_CONCURRENCY=4
META_TTL_SEC=21600
INFO_JSON_TTL_SEC=10800
OEMBED_TTL_SEC=86400
PLAYLIST_TTL_SEC=1800
JOB_TTL_SEC=7200

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

SSE_HEARTBEAT_MS=15000
SSE_MAX_LIFETIME_MS=1800000
SSE_MAX_PER_JOB=5

SHUTDOWN_GRACE_MS=30000

# Vacío = verificación de Turnstile desactivada.
TURNSTILE_SECRET=