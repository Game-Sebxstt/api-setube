{
  "name": "api-setube",
  "version": "2.0.0",
  "private": true,
  "description": "Setube v2: API de conversión de YouTube en streaming (Fastify 5)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner --project unit",
    "test:integration": "vitest run --configLoader runner --project integration --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/type-provider-typebox": "6.3.0",
    "ajv-formats": "3.0.1",
    "archiver": "8.0.0",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "ioredis": "5.11.1",
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/archiver": "8.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
